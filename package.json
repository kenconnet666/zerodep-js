{
  "name": "zerodep-js-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel --filter \"!@zerodep-js/docs\" dev",
    "dev:docs": "pnpm build:packages && pnpm --filter @zerodep-js/docs dev",
    "dev:csr": "pnpm build:packages && pnpm --filter @zerodep-js/example dev --render-mode csr",
    "dev:ssr": "pnpm build:packages && pnpm --filter @zerodep-js/example dev --render-mode ssr",
    "build:packages": "tsc -b tsconfig.build.json",
    "check": "pnpm native:check && pnpm css:check && pnpm ui:check && pnpm build:packages && pnpm check:projects && pnpm lint",
    "check:projects": "pnpm --filter zerodep-js-ui build && node packages/compiler/dist/cli.js -p apps/docs/tsconfig.json && node packages/compiler/dist/cli.js -p apps/example/tsconfig.json && node packages/compiler/dist/cli.js -p tsconfig.tools.json",
    "check:config": "tsc -p tsconfig.tools.json",
    "build": "pnpm build:packages && pnpm --filter zerodep-js-ui build && pnpm --filter @zerodep-js/docs build && pnpm --filter @zerodep-js/example build",
    "build:ui": "pnpm build:packages && pnpm --filter zerodep-js-ui build",
    "build:docs": "pnpm build:ui && pnpm --filter @zerodep-js/docs build",
    "preview:docs": "pnpm --filter @zerodep-js/docs preview",
    "preview": "pnpm --filter @zerodep-js/example preview",
    "lint": "oxlint . --deny-warnings",
    "test": "pnpm build:ui && vitest run",
    "test:ui": "pnpm build:ui && vitest run packages/ui/test",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:chromium": "pnpm test:e2e --project=chromium",
    "test:dev": "node scripts/verify-dev.mjs",
    "test:packages": "pnpm build:packages && node scripts/verify-packages.mjs",
    "test:packages:registry": "node scripts/verify-packages.mjs --registry",
    "release:check": "node --use-env-proxy scripts/release.mjs check",
    "release:ci": "node --use-env-proxy scripts/release-ci.mjs",
    "release:prepare": "node --use-env-proxy scripts/release.mjs prepare",
    "release:pack": "node --use-env-proxy scripts/release.mjs pack",
    "release:status": "node --use-env-proxy scripts/release.mjs status",
    "release:publish": "node --use-env-proxy scripts/release.mjs publish",
    "release:verify-registry": "node --use-env-proxy scripts/release.mjs verify-registry",
    "release:promote": "node --use-env-proxy scripts/release.mjs promote",
    "test:stability": "pnpm build:packages && node --expose-gc scripts/verify-stability.mjs",
    "browsers:install": "playwright install chromium firefox webkit",
    "format": "node scripts/format.mjs --write .",
    "format:check": "node scripts/format.mjs --check .",
    "native:generate": "node scripts/generate-native.mjs",
    "native:check": "node scripts/generate-native.mjs --check",
    "lsp:setup": "node scripts/language-services/setup.mjs",
    "lsp:verify": "node scripts/language-services/verify.mjs",
    "lsp:completions": "node scripts/language-services/completions.mjs .",
    "lsp:inspect": "node scripts/language-services/inspect.mjs .",
    "test:compiler": "pnpm build:packages && vitest run --config vitest.compiler.config.ts",
    "css:generate": "node scripts/generate-css-author.mjs --write",
    "css:check": "node scripts/generate-css-author.mjs --check",
    "ui:generate": "node scripts/generate-ui-exports.mjs --write",
    "ui:check": "node scripts/generate-ui-exports.mjs --check",
    "test:css": "node --test packages/css/test/runtime/*.test.mjs packages/css/test/package/*.test.mjs"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "html-element-attributes": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "property-information": "catalog:",
    "smol-toml": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "vite": "catalog:",
    "zerodep-js-css": "workspace:*",
    "zerodep-js": "workspace:*",
    "zerodep-js-compiler": "workspace:*",
    "@babel/parser": "catalog:"
  }
}
