{
  "name": "zerodep-js-css",
  "version": "1.0.0-rc.9",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.11 <25"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "node": "./dist/server.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "scripts": {
    "dev": "tsc -b --watch",
    "check": "tsc -p tsconfig.json --noEmit --incremental false --composite false",
    "build": "tsc -b"
  },
  "dependencies": {
    "csstype": "catalog:"
  },
  "devDependencies": {
    "zerodep-js": "workspace:*",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-js.git",
    "directory": "packages/css"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-js#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/zerodep-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "zerodep-js 原生 CSS 作者、隐式变量与浏览器/SSR 样式管理",
  "peerDependencies": {
    "zerodep-js": "workspace:*"
  }
}
