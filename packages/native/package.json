{
  "name": "zerodep-js-native",
  "version": "1.0.0-rc.6",
  "type": "module",
  "license": "MIT",
  "author": "kenconnet666",
  "engines": {
    "node": ">=24.11 <25"
  },
  "bin": {
    "zerodep-tsc": "./dist/cli.js",
    "zerodep-tools": "./dist/tool-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/native/tsc.mjs -b",
    "dev": "node ../../scripts/native/tsc.mjs -b --watch",
    "check": "node ../../scripts/native/tsc.mjs -p tsconfig.json --noEmit --incremental false --composite false"
  },
  "dependencies": {
    "typescript": "catalog:",
    "vscode-jsonrpc": "catalog:"
  },
  "optionalDependencies": {
    "zerodep-js-native-win32-x64": "workspace:*",
    "zerodep-js-native-win32-arm64": "workspace:*",
    "zerodep-js-native-linux-x64": "workspace:*",
    "zerodep-js-native-linux-arm64": "workspace:*",
    "zerodep-js-native-darwin-x64": "workspace:*",
    "zerodep-js-native-darwin-arm64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@jridgewell/trace-mapping": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-js.git",
    "directory": "packages/native"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
