{
  "name": "zerodep-js-ssr",
  "version": "1.0.0-rc.9",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.11 <25"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "scripts": {
    "dev": "tsc -b --watch",
    "check": "tsc -p tsconfig.json --noEmit --incremental false --composite false",
    "build": "tsc -b"
  },
  "peerDependencies": {
    "zerodep-js": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "zerodep-js": "workspace:*",
    "typescript": "catalog:",
    "zerodep-js-css": "workspace:*"
  },
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-js.git",
    "directory": "packages/ssr"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-js#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/zerodep-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
