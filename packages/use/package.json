{
  "name": "zerodep-use",
  "version": "1.0.0-rc.5",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.11 <25"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src",
    "LICENSE"
  ],
  "exports": {
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/native/tsc.mjs -b --watch",
    "check": "node ../../scripts/native/tsc.mjs -p tsconfig.json --noEmit --incremental false --composite false",
    "build": "node ../../scripts/native/tsc.mjs -b"
  },
  "peerDependencies": {
    "zerodep-js": "workspace:*"
  },
  "devDependencies": {
    "zerodep-js": "workspace:*",
    "zerodep-js-ssr": "workspace:*",
    "typescript": "catalog:"
  },
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-js.git",
    "directory": "packages/use"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-js#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/zerodep-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
