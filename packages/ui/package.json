{
  "name": "zerodep-js-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "zerodep-check -p tsconfig.json",
    "build": "vite build",
    "build:types": "tsc -p tsconfig.build.json --noCheck",
    "test": "pnpm -w exec vitest run packages/ui/test",
    "generate": "node ../../scripts/generate-ui-exports.mjs --write",
    "generate:check": "node ../../scripts/generate-ui-exports.mjs --check"
  },
  "peerDependencies": {
    "zerodep-js": "workspace:*",
    "zerodep-js-css": "workspace:*"
  },
  "dependencies": {
    "@lucide/icons": "catalog:",
    "date-fns": "catalog:",
    "@date-fns/tz": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "zerodep-js": "workspace:*",
    "zerodep-js-css": "workspace:*",
    "zerodep-js-compiler": "workspace:*"
  }
}
