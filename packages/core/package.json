{
  "name": "zerodep-js",
  "version": "1.0.0-rc.7",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.11 <25"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./css": {
      "node": {
        "types": "./dist/css-server.d.ts",
        "import": "./dist/css-server.js"
      },
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js"
    },
    "./css/internal": {
      "types": "./dist/css-internal.d.ts",
      "import": "./dist/css-internal.js"
    }
  },
  "scripts": {
    "dev": "tsc -b --watch",
    "check": "tsc -p tsconfig.json --noEmit --incremental false --composite false",
    "build": "tsc -b"
  },
  "dependencies": {
    "@csstools/css-tokenizer": "catalog:",
    "csstype": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "zerodep-css": "catalog:"
  },
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-js#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/zerodep-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "zerodep-css": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "zerodep-css": {
      "optional": true
    }
  }
}
