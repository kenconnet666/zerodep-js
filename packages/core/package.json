{
  "name": "zerodep-js",
  "version": "1.0.0-rc.9",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.11 <25"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noCheck --watch",
    "check": "tsc -p tsconfig.json --noEmit --incremental false --composite false",
    "build": "tsc -p tsconfig.json --noCheck",
    "test": "pnpm -w exec vitest run packages/core/test",
    "generate": "node ../../scripts/generate-native.mjs",
    "generate:check": "node ../../scripts/generate-native.mjs --check",
    "test:stability": "node --expose-gc ../../scripts/verify-stability.mjs"
  },
  "dependencies": {
    "@csstools/css-tokenizer": "catalog:",
    "csstype": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-js#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/zerodep-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
