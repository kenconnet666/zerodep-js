{
  "name": "@zerodep-js/compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "bin": {
    "zerodep-check": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -b --watch",
    "check": "tsc -p tsconfig.json --noEmit --incremental false --composite false",
    "build": "tsc -b"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "catalog:",
    "@types/convert-source-map": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
