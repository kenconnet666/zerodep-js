{
  "name": "zerodep-js-compiler",
  "version": "1.0.0-rc.9",
  "type": "module",
  "sideEffects": [
    "./dist/tooling/cli.js",
    "./dist/language/server.js"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "bin": {
    "zerodep-check": "./bin/check.mjs",
    "zerodep-language-server": "./bin/language-server.mjs"
  },
  "files": [
    "bin",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -b --watch",
    "check": "tsc -p tsconfig.json --noEmit --incremental false --composite false",
    "build": "tsc -b"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "typescript": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "vscode-languageserver-types": "catalog:",
    "vscode-languageserver": "catalog:",
    "vscode-languageserver-textdocument": "catalog:"
  },
  "devDependencies": {
    "@types/convert-source-map": "catalog:",
    "@types/node": "catalog:",
    "zerodep-js-css": "workspace:*",
    "zerodep-js": "workspace:*",
    "vite": "catalog:"
  },
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zerodep-js.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/kenconnet666/zerodep-js#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/zerodep-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vite": "^8.3.1"
  }
}
