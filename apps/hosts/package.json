{
  "name": "@zerodep-js/hosts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "node server.ts --production"
  },
  "dependencies": {
    "zerodep-js": "workspace:*",
    "zerodep-js-react": "workspace:*",
    "zerodep-js-vue": "workspace:*",
    "zerodep-js-svelte": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vue": "catalog:",
    "@vue/server-renderer": "catalog:",
    "svelte": "catalog:",
    "sirv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "zerodep-js-vite": "workspace:*",
    "vite": "catalog:",
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:"
  }
}
