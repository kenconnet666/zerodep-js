{
  "name": "@zerodep-js/example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.ts",
    "check": "zerodep-check -p tsconfig.json",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "node server.ts --production",
    "dev:csr": "node --watch server.ts --render-mode csr",
    "dev:ssr": "node --watch server.ts --render-mode ssr",
    "check:tsx": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w exec vitest run apps/example/test",
    "test:dev": "node ../../scripts/verify-dev.mjs"
  },
  "dependencies": {
    "zerodep-js": "workspace:*",
    "sirv": "catalog:",
    "zerodep-js-css": "workspace:*"
  },
  "devDependencies": {
    "zerodep-js-compiler": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
