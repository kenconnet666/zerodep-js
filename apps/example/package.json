{
  "name": "@zerodep-js/example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "node server.ts --production"
  },
  "dependencies": {
    "zerodep-js": "workspace:*",
    "zerodep-js-ssr": "workspace:*",
    "sirv": "catalog:",
    "zod": "catalog:",
    "zerodep-use": "workspace:*"
  },
  "devDependencies": {
    "zerodep-js-vite": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
