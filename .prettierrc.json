{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "plugins": ["@prettier/plugin-oxc", "prettier-plugin-svelte"],
  "overrides": [
    { "files": ["*.js", "*.jsx", "*.mjs", "*.cjs"], "options": { "parser": "oxc" } },
    { "files": ["*.ts", "*.tsx", "*.mts", "*.cts"], "options": { "parser": "oxc-ts" } },
    { "files": "*.svelte", "options": { "parser": "svelte" } }
  ]
}
