+package fourslash_test
+
+import (
+	"testing"
+
+	"github.com/microsoft/TypeScript/tsc/internal/fourslash"
+	. "github.com/microsoft/TypeScript/tsc/internal/fourslash/tests/util"
+	"github.com/microsoft/TypeScript/tsc/internal/ls/lsutil"
+	"github.com/microsoft/TypeScript/tsc/internal/lsp/lsproto"
+	"github.com/microsoft/TypeScript/tsc/internal/testutil"
+)
+
+func TestJsxNamespacedAttributeCompletions(t *testing.T) {
+	t.Parallel()
+	defer testutil.RecoverAndFail(t, "Panic on fourslash test")
+	const content = `// @jsx: preserve
+// @Filename: /a.tsx
+declare namespace JSX {
+    interface Element {}
+    interface IntrinsicElements {
+        input: {
+            normal: boolean;
+            "aria-label": string;
+            /** Bound value */
+            "bind:value": string;
+            "on:click": () => void;
+            "invalid:a:b": string;
+            ":value": string;
+            "bind:": string;
+        }
+    }
+}
+
+<input /*empty*/ />;
+<input bind/*prefix*/ />;
+<input bind:/*colon*/ />;
+<input bind:v/*local*/ />;
+<input bi/*namespace*/nd:value />;
+<input bind:va/*middle*/lue />;
+<input bind : v/*spaces*/ />;`
+	f, done := fourslash.NewFourslash(t, nil, content)
+	defer done()
+	f.VerifyCompletions(t, []string{"empty", "prefix", "colon", "local", "namespace", "middle", "spaces"}, &fourslash.CompletionsExpectedList{
+		IsIncomplete: false,
+		ItemDefaults: &fourslash.CompletionsExpectedItemDefaults{
+			CommitCharacters: &DefaultCommitCharacters,
+			EditRange:        Ignored,
+		},
+		Items: &fourslash.CompletionsExpectedItems{
+			Exact: []fourslash.CompletionsExpectedItem{"aria-label", "bind:value", "normal", "on:click"},
+		},
+	})
+}
+
+func TestJsxNamespacedAttributeCompletionEdits(t *testing.T) {
+	t.Parallel()
+	for _, snippets := range []bool{false, true} {
+		name := "plain"
+		if snippets {
+			name = "snippet"
+		}
+		t.Run(name, func(t *testing.T) {
+			defer testutil.RecoverAndFail(t, "Panic on fourslash test")
+			const content = `// @jsx: preserve
+// @Filename: /a.tsx
+declare namespace JSX {
+    interface Element {}
+    interface IntrinsicElements { input: { "bind:value": string } }
+}
+<>🚀<input [|bind:v/**/|] /></>;`
+			f, done := fourslash.NewFourslash(t, fourslash.GetDefaultCapabilitiesWithOptions(&fourslash.ClientCapabilitiesOptions{
+				CompletionItem: &lsproto.ClientCompletionItemOptions{SnippetSupport: new(snippets)},
+			}), content)
+			defer done()
+			text := "bind:value"
+			var format *lsproto.InsertTextFormat
+			var insertText *string
+			if snippets {
+				text += "={$1}"
+				format = new(lsproto.InsertTextFormatSnippet)
+				insertText = new(text)
+			}
+			f.VerifyCompletions(t, "", &fourslash.CompletionsExpectedList{
+				IsIncomplete: false,
+				ItemDefaults: &fourslash.CompletionsExpectedItemDefaults{
+					CommitCharacters: &DefaultCommitCharacters,
+					EditRange:        Ignored,
+				},
+				Items: &fourslash.CompletionsExpectedItems{Exact: []fourslash.CompletionsExpectedItem{
+					&lsproto.CompletionItem{
+						Label:            "bind:value",
+						TextEdit:         &lsproto.TextEditOrInsertReplaceEdit{TextEdit: &lsproto.TextEdit{Range: f.Ranges()[0].LSRange, NewText: text}},
+						InsertText:       insertText,
+						FilterText:       new("bind:value"),
+						InsertTextFormat: format,
+					},
+				}},
+				UserPreferences: &lsutil.UserPreferences{JsxAttributeCompletionStyle: lsutil.JsxAttributeCompletionStyleBraces},
+			})
+		})
+	}
+}
