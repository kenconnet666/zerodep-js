+package fourslash_test
+
+import (
+	"testing"
+
+	"github.com/microsoft/TypeScript/tsc/internal/fourslash"
+	"github.com/microsoft/TypeScript/tsc/internal/testutil"
+)
+
+func TestGoToDefinitionJsxNamespacedAttribute(t *testing.T) {
+	t.Parallel()
+	defer testutil.RecoverAndFail(t, "Panic on fourslash test")
+	const content = `// @jsx: preserve
+// @Filename: /a.tsx
+declare namespace JSX {
+    interface Element {}
+    interface IntrinsicElements {
+        input: { "bind:value": string; "prop:custom": number };
+        "svg:path": {};
+    }
+}
+interface Props { value: string }
+declare function Explicit(props: { "bind:value": string }): JSX.Element;
+declare function Mapped(props: { [K in keyof Props as ` + "`bind:${K}`" + `]: Props[K] }): JSX.Element;
+<input bi/*nativeNamespace*/nd:va/*nativeLocal*/lue="text" prop:cus/*custom*/tom={1} />;
+<Explicit bi/*explicitNamespace*/nd:va/*explicitLocal*/lue="text" />;
+<Mapped bi/*mappedNamespace*/nd:va/*mappedLocal*/lue="text" />;
+<svg:pa/*tag*/th />;`
+	f, done := fourslash.NewFourslash(t, nil, content)
+	defer done()
+	f.VerifyNoErrors(t)
+	f.VerifyBaselineGoToDefinition(t, true,
+		"nativeNamespace", "nativeLocal", "custom", "explicitNamespace", "explicitLocal",
+		"mappedNamespace", "mappedLocal", "tag")
+}
