{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsxImportSource": "@zerodep-js/core",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "noEmit": true
  },
  "exclude": ["tests/consumer"],
  "include": [
    "*.config.ts",
    "babel.config.mjs",
    "apps/*/vite.config.ts",
    "apps/*/server.ts",
    "apps/*/src/**/*.d.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "apps/*/test/**/*.ts"
  ]
}
